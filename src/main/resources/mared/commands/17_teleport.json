{
  "commands": [
    {
      "name": "teleport",
      "category": "Entity",
      "opLevel": 2,
      "description": "Teleport entities",
      "example": "/teleport @s 100 64 100",
      "arguments": [
        { "value": "<target>", "description": "Who to teleport", "examples": ["/teleport @s 100 64 100"] },
        { "value": "<destination>", "description": "Where to teleport", "examples": ["/teleport @s 100 64 100"] },
        { "value": "<target> <entity>", "description": "Teleport to another entity", "examples": ["/teleport @s @e[type=pig,limit=1]"] },
        { "value": "facing <pos>", "description": "Face position after teleport", "examples": ["/teleport @s 100 64 100 facing 200 64 200"] },
        { "value": "facing entity <target>", "description": "Face entity after teleport", "examples": ["/teleport @s 100 64 100 facing entity @p"] }
      ]
    }
  ]
}