{
  "commands": [
    {
      "name": "spawnpoint",
      "category": "Player",
      "opLevel": 2,
      "description": "Set spawn point for a player",
      "example": "/spawnpoint @s 0 64 0",
      "arguments": [
        { "value": "[player]", "description": "Target player", "examples": ["/spawnpoint @s", "/spawnpoint @a"] },
        { "value": "[pos]", "description": "Spawn coordinates", "examples": ["/spawnpoint @s 100 64 100"] },
        { "value": "[angle]", "description": "Spawn angle", "examples": ["/spawnpoint @s 100 64 100 90"] }
      ]
    }
  ]
}