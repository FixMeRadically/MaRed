{
  "commands": [
    {
      "name": "attribute",
      "category": "Entity",
      "opLevel": 2,
      "description": "Attribute alternate syntax",
      "description_ru": "Альтернативный синтаксис attribute",
      "example": "/attribute @s minecraft:generic.max_health get",
      "arguments": [
        { "value": "get", "description": "Get value", "description_ru": "Получить значение", "examples": ["/attribute @s minecraft:generic.max_health get"] },
        { "value": "base get", "description": "Get base value", "description_ru": "Получить базовое значение", "examples": ["/attribute @s minecraft:generic.max_health base get"] },
        { "value": "base set <n>", "description": "Set base value", "description_ru": "Задать базовое значение", "examples": ["/attribute @s minecraft:generic.max_health base set 40"] },
        { "value": "modifier add <id> <value> <operation>", "description": "Add modifier", "description_ru": "Добавить модификатор", "examples": ["/attribute @s minecraft:generic.max_health modifier add my:id 10 add_value"] },
        { "value": "modifier remove <id>", "description": "Remove modifier", "description_ru": "Удалить модификатор", "examples": ["/attribute @s minecraft:generic.max_health modifier remove my:id"] },
        { "value": "modifier value get <id>", "description": "Get modifier value", "description_ru": "Получить значение модификатора", "examples": ["/attribute @s minecraft:generic.max_health modifier value get my:id"] }
      ]
    }
  ]
}