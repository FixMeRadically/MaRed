{
  "commands": [
    {
      "name": "recipe",
      "category": "Player",
      "opLevel": 2,
      "description": "Give or take recipes from players",
      "description_ru": "Выдать или забрать рецепты у игроков",
      "example": "/recipe give @s *",
      "arguments": [
        { "value": "give", "description": "Unlock recipe for player", "description_ru": "Открыть рецепт игроку", "examples": ["/recipe give @s minecraft:crafting_table"] },
        { "value": "take", "description": "Lock recipe for player", "description_ru": "Закрыть рецепт игроку", "examples": ["/recipe take @s minecraft:crafting_table"] },
        { "value": "<target>", "description": "Who to affect", "description_ru": "Кому применить", "examples": ["/recipe give @a *"] },
        { "value": "<recipe>", "description": "Recipe ID or * for all", "description_ru": "ID рецепта или * для всех", "examples": ["/recipe give @s *", "/recipe give @s minecraft:stick"] }
      ]
    }
  ]
}