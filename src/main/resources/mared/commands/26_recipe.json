{
  "commands": [
    {
      "name": "recipe",
      "category": "Player",
      "opLevel": 2,
      "description": "Give or take recipes from players",
      "example": "/recipe give @s *",
      "arguments": [
        { "value": "give", "description": "Unlock recipe for player", "examples": ["/recipe give @s minecraft:crafting_table"] },
        { "value": "take", "description": "Lock recipe for player", "examples": ["/recipe take @s minecraft:crafting_table"] },
        { "value": "<target>", "description": "Who to affect", "examples": ["/recipe give @a *"] },
        { "value": "<recipe>", "description": "Recipe ID or * for all", "examples": ["/recipe give @s *", "/recipe give @s minecraft:stick"] }
      ]
    }
  ]
}