{
  "commands": [
    {
      "name": "team",
      "category": "Player",
      "opLevel": 2,
      "description": "Manage teams",
      "example": "/team add red",
      "arguments": [
        { "value": "add <name>", "description": "Create team", "examples": ["/team add red"] },
        { "value": "remove <name>", "description": "Delete team", "examples": ["/team remove red"] },
        { "value": "empty <name>", "description": "Remove all members", "examples": ["/team empty red"] },
        { "value": "join <name> [members]", "description": "Add members", "examples": ["/team join red @s", "/team join red @a"] },
        { "value": "leave <members>", "description": "Remove members from team", "examples": ["/team leave @s"] },
        { "value": "list [name]", "description": "List teams or members", "examples": ["/team list", "/team list red"] },
        { "value": "modify <name> color <color>", "description": "Set team color", "examples": ["/team modify red color red"] },
        { "value": "modify <name> friendlyFire <true|false>", "description": "Toggle friendly fire", "examples": ["/team modify red friendlyFire false"] },
        { "value": "modify <name> prefix <json>", "description": "Set chat prefix", "examples": ["/team modify red prefix {\"text\":\"[R] \"}"] },
        { "value": "modify <name> suffix <json>", "description": "Set chat suffix", "examples": ["/team modify red suffix {\"text\":\"\"}"] }
      ]
    }
  ]
}