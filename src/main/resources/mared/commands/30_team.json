{
  "commands": [
    {
      "name": "team",
      "category": "Player",
      "opLevel": 2,
      "description": "Manage teams",
      "description_ru": "Управление командами",
      "example": "/team add red",
      "arguments": [
        { "value": "add <name>", "description": "Create team", "description_ru": "Создать команду", "examples": ["/team add red"] },
        { "value": "remove <name>", "description": "Delete team", "description_ru": "Удалить команду", "examples": ["/team remove red"] },
        { "value": "empty <name>", "description": "Remove all members", "description_ru": "Убрать всех участников", "examples": ["/team empty red"] },
        { "value": "join <name> [members]", "description": "Add members", "description_ru": "Добавить участников", "examples": ["/team join red @s", "/team join red @a"] },
        { "value": "leave <members>", "description": "Remove members from team", "description_ru": "Убрать участников из команды", "examples": ["/team leave @s"] },
        { "value": "list [name]", "description": "List teams or members", "description_ru": "Список команд или участников", "examples": ["/team list", "/team list red"] },
        { "value": "modify <name> color <color>", "description": "Set team color", "description_ru": "Задать цвет команды", "examples": ["/team modify red color red"] },
        { "value": "modify <name> friendlyFire <true|false>", "description": "Toggle friendly fire", "description_ru": "Переключить огонь по своим", "examples": ["/team modify red friendlyFire false"] },
        { "value": "modify <name> prefix <json>", "description": "Set chat prefix", "description_ru": "Задать префикс в чате", "examples": ["/team modify red prefix {\"text\":\"[R] \"}"] },
        { "value": "modify <name> suffix <json>", "description": "Set chat suffix", "description_ru": "Задать суффикс в чате", "examples": ["/team modify red suffix {\"text\":\"\"}"] }
      ]
    }
  ]
}