{
  "commands": [
    {
      "name": "scoreboard",
      "category": "Player",
      "opLevel": 2,
      "description": "Manage scoreboard objectives, players and teams",
      "description_ru": "Управление целями, игроками и командами таблицы очков",
      "example": "/scoreboard objectives add kills minecraft.player_kill_count",
      "arguments": [
        { "value": "objectives add <name> <criteria>", "description": "Add objective", "description_ru": "Добавить цель", "examples": ["/scoreboard objectives add kills minecraft.player_kill_count"] },
        { "value": "objectives remove <name>", "description": "Remove objective", "description_ru": "Удалить цель", "examples": ["/scoreboard objectives remove kills"] },
        { "value": "objectives list", "description": "List objectives", "description_ru": "Список целей", "examples": ["/scoreboard objectives list"] },
        { "value": "objectives setdisplay <slot> <name>", "description": "Set display slot", "description_ru": "Задать слот отображения", "examples": ["/scoreboard objectives setdisplay sidebar kills"] },
        { "value": "objectives modify <name> displayname <json>", "description": "Change display name", "description_ru": "Изменить отображаемое имя", "examples": ["/scoreboard objectives modify kills displayname {\"text\":\"Kills\"}"] },
        { "value": "players set <target> <objective> <score>", "description": "Set player score", "description_ru": "Задать очки игрока", "examples": ["/scoreboard players set @s kills 10"] },
        { "value": "players add <target> <objective> <score>", "description": "Add to player score", "description_ru": "Прибавить к очкам игрока", "examples": ["/scoreboard players add @s kills 1"] },
        { "value": "players remove <target> <objective> <score>", "description": "Subtract from score", "description_ru": "Отнять от очков", "examples": ["/scoreboard players remove @s kills 1"] },
        { "value": "players reset <target> <objective>", "description": "Reset score", "description_ru": "Сбросить очки", "examples": ["/scoreboard players reset @s kills"] },
        { "value": "players get <target> <objective>", "description": "Get player score", "description_ru": "Получить очки игрока", "examples": ["/scoreboard players get @s kills"] }
      ]
    }
  ]
}