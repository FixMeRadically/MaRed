{
  "commands": [
    {
      "name": "particle",
      "category": "World",
      "opLevel": 2,
      "description": "Spawn particles",
      "description_ru": "Создать частицы",
      "example": "/particle minecraft:flame ~ ~1 ~ 1 1 1 0 10",
      "arguments": [
        { "value": "<name>", "description": "Particle ID", "description_ru": "ID частицы", "examples": ["/particle minecraft:flame ~ ~1 ~"] },
        { "value": "<pos>", "description": "Center position", "description_ru": "Позиция центра", "examples": ["/particle minecraft:flame ~ ~1 ~"] },
        { "value": "<delta>", "description": "Spread (x y z)", "description_ru": "Разброс (x y z)", "examples": ["/particle minecraft:flame ~ ~1 ~ 1 1 1 0 10"] },
        { "value": "<speed>", "description": "Speed", "description_ru": "Скорость", "examples": ["/particle minecraft:flame ~ ~1 ~ 0 0 0 0.1 10"] },
        { "value": "<count>", "description": "Number of particles", "description_ru": "Количество частиц", "examples": ["/particle minecraft:flame ~ ~1 ~ 0 0 0 0 50"] },
        { "value": "force", "description": "Force display (ignore settings)", "description_ru": "Принудительно показать (игнорировать настройки)", "examples": ["/particle minecraft:flame ~ ~1 ~ 0 0 0 0 10 force"] },
        { "value": "normal", "description": "Default display", "description_ru": "Обычный показ", "examples": ["/particle minecraft:flame ~ ~1 ~ 0 0 0 0 10 normal"] }
      ]
    }
  ]
}