{
  "commands": [
    {
      "name": "clone",
      "category": "World",
      "opLevel": 2,
      "description": "Clone blocks from one region to another",
      "example": "/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~",
      "arguments": [
        { "value": "<begin>", "description": "First corner of source region", "examples": ["/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~"] },
        { "value": "<end>", "description": "Second corner of source region", "examples": ["/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~"] },
        { "value": "<destination>", "description": "Target corner", "examples": ["/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~"] },
        { "value": "replace", "description": "Replace all blocks in target (default)", "examples": ["/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~ replace"] },
        { "value": "masked", "description": "Only copy non-air blocks", "examples": ["/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~ masked"] },
        { "value": "force", "description": "Force clone even into occupied area", "examples": ["/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~ force"] },
        { "value": "move", "description": "Move instead of copy", "examples": ["/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~ move"] },
        { "value": "normal", "description": "Copy without filtering (default)", "examples": ["/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~ normal"] }
      ],
      "nbt": [
        { "tag": "replace", "what": "Replace mode", "why": "Overwrite target region completely", "example": "/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~ replace" },
        { "tag": "masked", "what": "Masked mode", "why": "Only copy non-air blocks", "example": "/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~ masked" },
        { "tag": "force", "what": "Force mode", "why": "Clone even if target region is occupied", "example": "/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~ force" },
        { "tag": "move", "what": "Move mode", "why": "Move blocks instead of copy", "example": "/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~ move" },
        { "tag": "normal", "what": "Normal mode", "why": "Copy without filtering", "example": "/clone ~ ~ ~ ~5 ~5 ~5 ~10 ~ ~ normal" }
      ]
    }
  ]
}