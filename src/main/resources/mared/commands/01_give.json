{
  "commands": [
    {
      "name": "give",
      "category": "Player",
      "opLevel": 2,
      "description": "Give items to a player",
      "example": "/give @s diamond 5",
      "arguments": [
        { "value": "<target>", "description": "Who receives", "examples": ["/give @s diamond 5", "/give @a bread 10"] },
        { "value": "<item>", "description": "Item ID", "examples": ["/give @s minecraft:diamond 5", "/give @s minecraft:netherite_sword 1"] },
        { "value": "[count]", "description": "How many", "examples": ["/give @s diamond 5"] }
      ],
      "nbt": [
        { "tag": "[minecraft:enchantments]", "what": "Enchantments on the item", "why": "Adds enchantments like sharpness, protection", "example": "/give @s diamond_sword[minecraft:enchantments={sharpness:5}]" },
        { "tag": "[minecraft:custom_name]", "what": "Custom display name (JSON)", "why": "Changes tooltip name", "example": "/give @s diamond[minecraft:custom_name='{\"text\":\"My Gem\"}']" },
        { "tag": "[minecraft:lore]", "what": "Lore lines (JSON)", "why": "Adds lore below name", "example": "/give @s diamond[minecraft:lore=['{\"text\":\"Line 1\"}']]" },
        { "tag": "[minecraft:unbreakable]", "what": "Makes item unbreakable", "why": "Prevents durability loss", "example": "/give @s netherite_pickaxe[minecraft:unbreakable={}]" },
        { "tag": "[minecraft:attribute_modifiers]", "what": "Attribute changes", "why": "Modify stats while holding", "example": "/give @s diamond_sword[minecraft:attribute_modifiers=[{type:\"generic.attack_damage\",amount:20,operation:\"add_value\",slot:\"mainhand\",id:\"my:damage\"}]]" },
        { "tag": "[minecraft:custom_model_data]", "what": "Custom model data", "why": "Resource pack model", "example": "/give @s stick[minecraft:custom_model_data={floats:[1.0]}]" },
        { "tag": "[minecraft:damage]", "what": "Current damage", "why": "How damaged the item is", "example": "/give @s diamond_sword[minecraft:damage=100]" },
        { "tag": "[minecraft:max_damage]", "what": "Max durability", "why": "Override max durability", "example": "/give @s diamond_sword[minecraft:max_damage=5000]" },
        { "tag": "[minecraft:max_stack_size]", "what": "Max stack size", "why": "Override stack limit", "example": "/give @s diamond[minecraft:max_stack_size=64]" },
        { "tag": "[minecraft:rarity]", "what": "Rarity", "why": "common/uncommon/rare/epic", "example": "/give @s diamond[minecraft:rarity=\"epic\"]" },
        { "tag": "[minecraft:custom_data]", "what": "Custom data (NBT)", "why": "Stores arbitrary data", "example": "/give @s stick[minecraft:custom_data={my_tag:1}]" },
        { "tag": "[minecraft:can_break]", "what": "Blocks it can break", "why": "For adventure mode", "example": "/give @s diamond_pickaxe[minecraft:can_break={blocks:[\"minecraft:stone\"]}]" },
        { "tag": "[minecraft:can_place_on]", "what": "Blocks it can place on", "why": "For adventure mode", "example": "/give @s dirt[minecraft:can_place_on={blocks:[\"minecraft:grass_block\"]}]" },
        { "tag": "[minecraft:dyed_color]", "what": "Dyed color", "why": "For leather armor", "example": "/give @s leather_helmet[minecraft:dyed_color=16711680]" },
        { "tag": "[minecraft:trim]", "what": "Armor trim", "why": "Pattern + material", "example": "/give @s netherite_chestplate[minecraft:trim={pattern:\"host\",material:\"emerald\"}]" },
        { "tag": "[minecraft:stored_enchantments]", "what": "Stored enchantments", "why": "For enchanted books", "example": "/give @s enchanted_book[minecraft:stored_enchantments={mending:1}]" },
        { "tag": "[minecraft:charged_projectiles]", "what": "Loaded projectiles", "why": "For crossbows", "example": "/give @s crossbow[minecraft:charged_projectiles=[{id:\"arrow\"}]]" },
        { "tag": "[minecraft:fireworks]", "what": "Firework data", "why": "For rockets", "example": "/give @s firework_rocket[minecraft:fireworks={flight_duration:1,explosions:[{shape:\"star\",colors:[16711680]}]}]" },
        { "tag": "[minecraft:potion_contents]", "what": "Potion contents", "why": "For potions", "example": "/give @s potion[minecraft:potion_contents={potion:\"minecraft:strength\"}]" },
        { "tag": "[minecraft:food]", "what": "Food data", "why": "nutrition, saturation", "example": "/give @s bread[minecraft:food={nutrition:10,saturation:10}]" },
        { "tag": "[minecraft:consumable]", "what": "Consumable data", "why": "Time, animation, sound", "example": "/give @s golden_apple[minecraft:consumable={consume_seconds:1.6,animation:\"eat\"}]" },
        { "tag": "[minecraft:equippable]", "what": "Equippable slot", "why": "Where item can be worn", "example": "/give @s diamond_helmet[minecraft:equippable={slot:\"head\"}]" },
        { "tag": "[minecraft:glider]", "what": "Glider flag", "why": "Allows elytra-like gliding", "example": "/give @s elytra[minecraft:glider={}]" },
        { "tag": "[minecraft:tool]", "what": "Tool data", "why": "Mining speed and rules", "example": "/give @s diamond_pickaxe[minecraft:tool={default_mining_speed:1.0}]" },
        { "tag": "[minecraft:weapon]", "what": "Weapon data", "why": "Damage per attack, blocking", "example": "/give @s diamond_sword[minecraft:weapon={item_damage_per_attack:7}]" },
        { "tag": "[minecraft:enchantment_glint_override]", "what": "Force glint on/off", "why": "Override enchantment glow", "example": "/give @s stick[minecraft:enchantment_glint_override=true]" },
        { "tag": "[minecraft:repair_cost]", "what": "Repair cost", "why": "Anvil repair cost", "example": "/give @s diamond_sword[minecraft:repair_cost=0]" },
        { "tag": "[minecraft:tooltip_display]", "what": "Hide tooltips", "why": "Hide components in tooltip", "example": "/give @s diamond_sword[minecraft:tooltip_display={hidden_components:[\"minecraft:enchantments\"]}]" },
        { "tag": "[minecraft:creative_slot_lock]", "what": "Lock slot", "why": "Cannot move item", "example": "/give @s diamond[minecraft:creative_slot_lock={}]" },
        { "tag": "[minecraft:map_color]", "what": "Map color", "why": "Color on maps", "example": "/give @s filled_map[minecraft:map_color=16711680]" },
        { "tag": "[minecraft:map_decorations]", "what": "Map markers", "why": "Icons on maps", "example": "/give @s filled_map[minecraft:map_decorations={my_marker:{type:\"target_x\",x:0.0,z:0.0,rotation:0.0}}]" },
        { "tag": "[minecraft:map_id]", "what": "Map ID", "why": "Unique map number", "example": "/give @s filled_map[minecraft:map_id=5]" },
        { "tag": "[minecraft:banner_patterns]", "what": "Banner patterns", "why": "Banner decoration", "example": "/give @s white_banner[minecraft:banner_patterns=[{pattern:\"triangle_top\",color:\"red\"}]]" },
        { "tag": "[minecraft:base_color]", "what": "Shield base color", "why": "For shields", "example": "/give @s shield[minecraft:base_color=\"lime\"]" },
        { "tag": "[minecraft:bees]", "what": "Bees in hive", "why": "For beehives", "example": "/give @s beehive[minecraft:bees=[{entity_data:{id:\"bee\"},min_ticks_in_hive:60}]]" },
        { "tag": "[minecraft:block_entity_data]", "what": "Block entity NBT", "why": "For block items", "example": "/give @s chest[minecraft:block_entity_data={id:\"chest\",Items:[]}]" },
        { "tag": "[minecraft:block_state]", "what": "Block state", "why": "For block items", "example": "/give @s oak_slab[minecraft:block_state={type:\"top\"}]" },
        { "tag": "[minecraft:entity_data]", "what": "Entity NBT", "why": "For spawn eggs", "example": "/give @s zombie_spawn_egg[minecraft:entity_data={id:\"zombie\",NoAI:1b}]" },
        { "tag": "[minecraft:bucket_entity_data]", "what": "Bucket entity NBT", "why": "For fish buckets", "example": "/give @s cod_bucket[minecraft:bucket_entity_data={Health:3.0f}]" },
        { "tag": "[minecraft:profile]", "what": "Player head profile", "why": "For player heads", "example": "/give @s player_head[minecraft:profile=\"MinecraftWiki\"]" },
        { "tag": "[minecraft:note_block_sound]", "what": "Note block sound", "why": "For note blocks", "example": "/give @s note_block[minecraft:note_block_sound=\"entity.item.pickup\"]" },
        { "tag": "[minecraft:recipes]", "what": "Recipes in book", "why": "For knowledge books", "example": "/give @s knowledge_book[minecraft:recipes=[\"minecraft:end_crystal\"]]" },
        { "tag": "[minecraft:writable_book_content]", "what": "Writable book pages", "why": "For book and quill", "example": "/give @s writable_book[minecraft:writable_book_content={pages:[{raw:\"Text\"}]}]" },
        { "tag": "[minecraft:written_book_content]", "what": "Written book data", "why": "Title, author, pages", "example": "/give @s written_book[minecraft:written_book_content={title:{raw:\"Book\"},author:\"Me\",pages:[{raw:\"Page 1\"}]}]" },
        { "tag": "[minecraft:lodestone_tracker]", "what": "Lodestone target", "why": "For compass", "example": "/give @s compass[minecraft:lodestone_tracker={target:{pos:[I;0,64,0],dimension:\"minecraft:overworld\"}}]" },
        { "tag": "[minecraft:ominous_bottle_amplifier]", "what": "Bad Omen level", "why": "For ominous bottles", "example": "/give @s ominous_bottle[minecraft:ominous_bottle_amplifier=4]" },
        { "tag": "[minecraft:suspicious_stew_effects]", "what": "Stew effects", "why": "For suspicious stew", "example": "/give @s suspicious_stew[minecraft:suspicious_stew_effects=[{id:\"minecraft:night_vision\",duration:200}]]" },
        { "tag": "[minecraft:potion_duration_scale]", "what": "Potion duration multiplier", "why": "Multiplies effect durations", "example": "/give @s potion[minecraft:potion_duration_scale=2.0]" },
        { "tag": "[minecraft:use_remainder]", "what": "Leftover item", "why": "Item given after use", "example": "/give @s honey_bottle[minecraft:use_remainder={id:\"minecraft:glass_bottle\"}]" },
        { "tag": "[minecraft:use_cooldown]", "what": "Use cooldown", "why": "Seconds between uses", "example": "/give @s ender_pearl[minecraft:use_cooldown={seconds:1.0}]" },
        { "tag": "[minecraft:death_protection]", "what": "Death protection", "why": "Prevent death", "example": "/give @s totem_of_undying[minecraft:death_protection={}]" },
        { "tag": "[minecraft:intangible_projectile]", "what": "Intangible projectile", "why": "Projectiles pass through entities", "example": "/give @s arrow[minecraft:intangible_projectile={}]" },
        { "tag": "[minecraft:instrument]", "what": "Goat horn instrument", "why": "Sound played", "example": "/give @s goat_horn[minecraft:instrument=\"minecraft:feel_goat_horn\"]" },
        { "tag": "[minecraft:jukebox_playable]", "what": "Jukebox song", "why": "Music disc song", "example": "/give @s music_disc_pigstep[minecraft:jukebox_playable=\"minecraft:pigstep\"]" },
        { "tag": "[minecraft:fire_resistant]", "what": "Fire resistant", "why": "Item survives lava", "example": "/give @s netherite_ingot[minecraft:fire_resistant={}]" },
        { "tag": "[minecraft:hide_additional_tooltip]", "what": "Hide tooltip", "why": "Hide extra info", "example": "/give @s potion[minecraft:hide_additional_tooltip={}]" },
        { "tag": "[minecraft:hide_tooltip]", "what": "Hide full tooltip", "why": "Hide everything", "example": "/give @s stick[minecraft:hide_tooltip={}]" }
      ]
    }
  ]
}