{
  "commands": [
    {
      "name": "data",
      "category": "Entity",
      "opLevel": 2,
      "description": "Read and modify NBT data",
      "example": "/data get entity @s Health",
      "arguments": [
        { "value": "get", "description": "Read NBT", "examples": ["/data get entity @s Health", "/data get block ~ ~1 ~"] },
        { "value": "merge", "description": "Merge NBT", "examples": ["/data merge entity @s {NoAI:1b}", "/data merge block ~ ~1 ~ {CustomName:'{\"text\":\"Hi\"}'}"] },
        { "value": "modify", "description": "Modify path", "examples": ["/data modify entity @s Health set value 20.0f"] },
        { "value": "remove", "description": "Remove NBT path", "examples": ["/data remove entity @s ActiveEffects"] },
        { "value": "entity", "description": "Target entity", "examples": ["/data get entity @s", "/data get entity @e[type=zombie,limit=1]"] },
        { "value": "block", "description": "Target block", "examples": ["/data get block ~ ~1 ~", "/data get block 100 64 100"] },
        { "value": "storage", "description": "Target command storage", "examples": ["/data get storage mypack:data"] },
        { "value": "set", "description": "Set value", "examples": ["/data modify entity @s Health set value 20.0f"] },
        { "value": "append", "description": "Append to list", "examples": ["/data modify block ~ ~1 ~ Items append value {Slot:0b,id:\"stone\",Count:1b}"] },
        { "value": "prepend", "description": "Prepend to list", "examples": ["/data modify block ~ ~1 ~ Items prepend value {Slot:0b,id:\"stone\",Count:1b}"] },
        { "value": "insert", "description": "Insert at index", "examples": ["/data modify block ~ ~1 ~ Items insert 0 value {Slot:0b,id:\"stone\",Count:1b}"] },
        { "value": "merge", "description": "Merge value", "examples": ["/data modify entity @s {CustomName:'{\"text\":\"Hi\"}'}"] },
        { "value": "from", "description": "Get value from source", "examples": ["/data modify entity @s Health set from entity @p Health"] },
        { "value": "string", "description": "Set string value", "examples": ["/data modify entity @s CustomName set value '{\"text\":\"Name\"}'"] },
        { "value": "value", "description": "Set literal value", "examples": ["/data modify entity @s Health set value 20.0f"] }
      ],
      "nbt": [
        { "tag": "get", "what": "Read a value", "why": "Print NBT to chat", "example": "/data get entity @s Health" },
        { "tag": "merge", "what": "Merge NBT into target", "why": "Add or overwrite NBT", "example": "/data merge entity @s {NoAI:1b}" },
        { "tag": "modify", "what": "Modify specific path", "why": "Change one value in NBT", "example": "/data modify entity @s Health set value 20.0f" },
        { "tag": "remove", "what": "Remove path", "why": "Delete NBT tag", "example": "/data remove entity @s ActiveEffects" },
        { "tag": "entity", "what": "Target entity", "why": "Read or modify entity NBT", "example": "/data get entity @s Health" },
        { "tag": "block", "what": "Target block", "why": "Read or modify block entity NBT", "example": "/data get block ~ ~1 ~" },
        { "tag": "storage", "what": "Target storage", "why": "Persistent command storage", "example": "/data get storage mypack:data" },
        { "tag": "set", "what": "Set operation", "why": "Set path to value", "example": "/data modify entity @s Health set value 20.0f" },
        { "tag": "append", "what": "Append operation", "why": "Add to end of list", "example": "/data modify block ~ ~1 ~ Items append value {Slot:0b,id:\"stone\",Count:1b}" },
        { "tag": "prepend", "what": "Prepend operation", "why": "Add to start of list", "example": "/data modify block ~ ~1 ~ Items prepend value {Slot:0b,id:\"stone\",Count:1b}" },
        { "tag": "insert", "what": "Insert operation", "why": "Insert at specific index", "example": "/data modify block ~ ~1 ~ Items insert 0 value {Slot:0b,id:\"stone\",Count:1b}" },
        { "tag": "merge", "what": "Merge operation", "why": "Merge compound tags", "example": "/data modify entity @s {CustomName:'{\"text\":\"Hi\"}'}" },
        { "tag": "from", "what": "Source from another target", "why": "Copy value from another NBT", "example": "/data modify entity @s Health set from entity @p Health" },
        { "tag": "string", "what": "String source", "why": "Use a string value", "example": "/data modify entity @s CustomName set value '{\"text\":\"Name\"}'" },
        { "tag": "value", "what": "Literal value", "why": "Use literal value", "example": "/data modify entity @s Health set value 20.0f" }
      ]
    }
  ]
}