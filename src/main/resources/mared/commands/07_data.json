        { "tag": "merge", "what": "Merge NBT into target", "what_ru": "Объединить NBT с целью", "why": "Add or overwrite NBT", "why_ru": "Добавить или перезаписать NBT", "example": "/data merge entity @s {NoAI:1b}" },
        { "tag": "modify", "what": "Modify specific path", "what_ru": "Изменить конкретный путь", "why": "Change one value in NBT", "why_ru": "Изменить одно значение в NBT", "example": "/data modify entity @s Health set value 20.0f" },
        { "tag": "remove", "what": "Remove path", "what_ru": "Удалить путь", "why": "Delete NBT tag", "why_ru": "Удалить NBT-тег", "example": "/data remove entity @s ActiveEffects" },
