      "arguments": [
        { "value": "get", "description": "Read NBT", "description_ru": "Прочитать NBT", "examples": ["/data get entity @s Health", "/data get block ~ ~1 ~"] },
        { "value": "merge", "description": "Merge NBT", "description_ru": "Объединить NBT", "examples": ["/data merge entity @s {NoAI:1b}"] },
        { "value": "modify", "description": "Modify path", "description_ru": "Изменить путь", "examples": ["/data modify entity @s Health set value 20.0f"] },
        { "value": "remove", "description": "Remove NBT path", "description_ru": "Удалить NBT-путь", "examples": ["/data remove entity @s ActiveEffects"] },
        { "value": "entity", "description": "Target entity", "description_ru": "Целевая сущность", "examples": ["/data get entity @s"] },
        { "value": "block", "description": "Target block", "description_ru": "Целевой блок", "examples": ["/data get block ~ ~1 ~"] },
        { "value": "storage", "description": "Target command storage", "description_ru": "Целевое командное хранилище", "examples": ["/data get storage mypack:data"] },
        { "value": "set", "description": "Set value", "description_ru": "Установить значение", "examples": ["/data modify entity @s Health set value 20.0f"] },
        { "value": "append", "description": "Append to list", "description_ru": "Добавить в список", "examples": ["/data modify block ~ ~1 ~ Items append value {Slot:0b,id:\"stone\",Count:1b}"] },
        { "value": "prepend", "description": "Prepend to list", "description_ru": "Добавить в начало списка", "examples": ["/data modify block ~ ~1 ~ Items prepend value {Slot:0b,id:\"stone\",Count:1b}"] },
        { "value": "insert", "description": "Insert at index", "description_ru": "Вставить по индексу", "examples": ["/data modify block ~ ~1 ~ Items insert 0 value {Slot:0b,id:\"stone\",Count:1b}"] },
        { "value": "merge", "description": "Merge value", "description_ru": "Объединить значение", "examples": ["/data modify entity @s {CustomName:'{\"text\":\"Hi\"}'}"] },
