        { "tag": "insert", "what": "Insert operation", "what_ru": "Операция insert", "why": "Insert at specific index", "why_ru": "Вставить по индексу", "example": "/data modify block ~ ~1 ~ Items insert 0 value {Slot:0b,id:\"stone\",Count:1b}" },
        { "tag": "merge", "what": "Merge operation", "what_ru": "Операция merge", "why": "Merge compound tags", "why_ru": "Объединить compound-теги", "example": "/data modify entity @s {CustomName:'{\"text\":\"Hi\"}'}" },
        { "tag": "from", "what": "Source from another target", "what_ru": "Источник из другой цели", "why": "Copy value from another NBT", "why_ru": "Копировать значение из другого NBT", "example": "/data modify entity @s Health set from entity @p Health" },
        { "tag": "string", "what": "String source", "what_ru": "Источник-строка", "why": "Use a string value", "why_ru": "Использовать строку", "example": "/data modify entity @s CustomName set value '{\"text\":\"Name\"}'" },
        { "tag": "value", "what": "Literal value", "what_ru": "Литеральное значение", "why": "Use literal value", "why_ru": "Использовать литеральное значение", "example": "/data modify entity @s Health set value 20.0f" }
      ]
    }
  ]
}