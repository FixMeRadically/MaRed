        { "tag": "block", "what": "Target block", "what_ru": "Целевой блок", "why": "Read or modify block entity NBT", "why_ru": "Читать/изменять NBT блока", "example": "/data get block ~ ~1 ~" },
        { "tag": "storage", "what": "Target storage", "what_ru": "Целевое хранилище", "why": "Persistent command storage", "why_ru": "Постоянное командное хранилище", "example": "/data get storage mypack:data" },
        { "tag": "set", "what": "Set operation", "what_ru": "Операция set", "why": "Set path to value", "why_ru": "Установить путь в значение", "example": "/data modify entity @s Health set value 20.0f" },
