        { "value": "<time>", "description": "Delay (e.g., 10s, 100t, 1d)", "description_ru": "Задержка (например, 10s, 100t, 1d)", "examples": ["/schedule function mypack:my_function 10s"] },
        { "value": "append", "description": "Add to schedule instead of replace", "description_ru": "Добавить в расписание вместо замены", "examples": ["/schedule function mypack:my_function 100t append"] },
        { "value": "replace", "description": "Replace existing schedule", "description_ru": "Заменить существующее расписание", "examples": ["/schedule function mypack:my_function 100t replace"] }
