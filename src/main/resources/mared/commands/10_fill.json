{
  "commands": [
    {
      "name": "fill",
      "category": "World",
      "opLevel": 2,
      "description": "Fill a region with a block",
      "description_ru": "Заполнить область блоком",
      "example": "/fill ~ ~ ~ ~5 ~5 ~5 minecraft:stone",
      "arguments": [
        { "value": "<from>", "description": "First corner", "description_ru": "Первый угол", "examples": ["/fill ~ ~ ~ ~5 ~5 ~5 minecraft:stone"] },
        { "value": "<to>", "description": "Second corner", "description_ru": "Второй угол", "examples": ["/fill ~ ~ ~ ~5 ~5 ~5 minecraft:stone"] },
        { "value": "<block>", "description": "Block ID", "description_ru": "ID блока", "examples": ["/fill ~ ~ ~ ~5 ~5 ~5 minecraft:diamond_block"] },
        { "value": "replace", "description": "Replace all (default)", "description_ru": "Заменить всё (по умолчанию)", "examples": ["/fill ~ ~ ~ ~5 ~5 ~5 minecraft:stone replace"] },
        { "value": "keep", "description": "Only air blocks", "description_ru": "Только воздух", "examples": ["/fill ~ ~ ~ ~5 ~5 ~5 minecraft:stone keep"] },
        { "value": "hollow", "description": "Only edges", "description_ru": "Только края", "examples": ["/fill ~ ~ ~ ~10 ~10 ~10 minecraft:stone hollow"] },
        { "value": "outline", "description": "Only outer shell", "description_ru": "Только внешняя оболочка", "examples": ["/fill ~ ~ ~ ~10 ~10 ~10 minecraft:stone outline"] },
        { "value": "replace <filter>", "description": "Only matching blocks", "description_ru": "Только совпадающие блоки", "examples": ["/fill ~ ~ ~ ~5 ~5 ~5 minecraft:stone replace minecraft:dirt"] }
      ],
      "nbt": [
        { "tag": "Block NBT", "what": "Extra NBT data", "what_ru": "Доп. NBT-данные", "why": "Adds properties to placed block", "why_ru": "Добавляет свойства размещаемому блоку", "example": "/fill ~ ~ ~ ~1 ~1 ~1 chest{Items:[{Slot:0b,id:\"diamond\",Count:1b}]}" },
        { "tag": "replace", "what": "Replace mode", "what_ru": "Режим replace", "why": "Replace all blocks including air", "why_ru": "Заменить все блоки включая воздух", "example": "/fill ~ ~ ~ ~5 ~5 ~5 stone replace" },
        { "tag": "keep", "what": "Keep mode", "what_ru": "Режим keep", "why": "Only fill air blocks", "why_ru": "Заполнять только воздух", "example": "/fill ~ ~ ~ ~5 ~5 ~5 stone keep" },
        { "tag": "hollow", "what": "Hollow mode", "what_ru": "Режим hollow", "why": "Only replace edges of region", "why_ru": "Заменять только края области", "example": "/fill ~ ~ ~ ~10 ~10 ~10 stone hollow" },
        { "tag": "outline", "what": "Outline mode", "what_ru": "Режим outline", "why": "Only outer shell, inner stays", "why_ru": "Только внешняя оболочка, внутри остаётся", "example": "/fill ~ ~ ~ ~10 ~10 ~10 stone outline" },
        { "tag": "replace <filter>", "what": "Replace filtered", "what_ru": "Замена с фильтром", "why": "Only replace blocks matching filter", "why_ru": "Заменять только совпадающие с фильтром", "example": "/fill ~ ~ ~ ~5 ~5 ~5 stone replace minecraft:dirt" }
      ]
    }
  ]
}