{
  "commands": [
    {
      "name": "place",
      "category": "World",
      "opLevel": 2,
      "description": "Place a feature, jigsaw or structure",
      "description_ru": "Разместить фичу, jigsaw или структуру",
      "example": "/place feature minecraft:village_plains ~ ~ ~",
      "arguments": [
        { "value": "feature <id>", "description": "Place a feature", "description_ru": "Разместить фичу", "examples": ["/place feature minecraft:oak ~ ~ ~"] },
        { "value": "jigsaw <id>", "description": "Place a jigsaw structure", "description_ru": "Разместить jigsaw-структуру", "examples": ["/place jigsaw minecraft:village_plains ~ ~ ~"] },
        { "value": "structure <id>", "description": "Place a structure", "description_ru": "Разместить структуру", "examples": ["/place structure minecraft:village_plains ~ ~ ~"] },
        { "value": "<pos>", "description": "Where to place", "description_ru": "Куда разместить", "examples": ["/place feature minecraft:oak 100 64 100"] }
      ]
    }
  ]
}