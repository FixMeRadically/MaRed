{
  "commands": [
    {
      "name": "ride",
      "category": "Entity",
      "opLevel": 2,
      "description": "Make entities ride other entities",
      "description_ru": "Посадить сущности на других сущностей",
      "example": "/ride @s mount @e[type=pig,limit=1]",
      "arguments": [
        { "value": "<target>", "description": "Who will ride", "description_ru": "Кто будет ехать", "examples": ["/ride @s mount @e[type=pig,limit=1]"] },
        { "value": "mount <vehicle>", "description": "Entity to ride", "description_ru": "Сущность, на которую сесть", "examples": ["/ride @s mount @e[type=pig,limit=1]"] },
        { "value": "dismount", "description": "Stop riding", "description_ru": "Прекратить ехать", "examples": ["/ride @s dismount"] }
      ]
    }
  ]
}