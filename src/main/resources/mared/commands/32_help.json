{
  "commands": [
    {
      "name": "help",
      "category": "Basic",
      "opLevel": 0,
      "description": "Show command help",
      "description_ru": "Показать справку по командам",
      "example": "/help",
      "arguments": [
        { "value": "[command]", "description": "Command name to get help for", "description_ru": "Название команды для справки", "examples": ["/help", "/help give", "/help execute"] }
      ]
    },
    {
      "name": "list",
      "category": "Basic",
      "opLevel": 0,
      "description": "List players online",
      "description_ru": "Список игроков онлайн",
      "example": "/list",
      "arguments": [
        { "value": "uuids", "description": "Show UUIDs", "description_ru": "Показать UUID", "examples": ["/list uuids"] }
      ]
    },
    {
      "name": "me",
      "category": "Basic",
      "opLevel": 0,
      "description": "Emote message from yourself",
      "description_ru": "Эмоциональное сообщение от себя",
      "example": "/me waves",
      "arguments": [
        { "value": "<action>", "description": "Emote text", "description_ru": "Текст эмоции", "examples": ["/me waves"] }
      ]
    },
    {
      "name": "msg",
      "category": "Basic",
      "opLevel": 0,
      "description": "Send a private message",
      "description_ru": "Отправить личное сообщение",
      "example": "/msg Notch Hi",
      "arguments": [
        { "value": "<target>", "description": "Recipient", "description_ru": "Получатель", "examples": ["/msg Notch Hi"] },
        { "value": "<message>", "description": "Message", "description_ru": "Сообщение", "examples": ["/msg Notch Hi"] }
      ]
    },
    {
      "name": "tell",
      "category": "Basic",
      "opLevel": 0,
      "description": "Alias for /msg",
      "description_ru": "Псевдоним /msg",
      "example": "/tell Notch Hi",
      "arguments": [
        { "value": "<target>", "description": "Recipient", "description_ru": "Получатель", "examples": ["/tell Notch Hi"] },
        { "value": "<message>", "description": "Message", "description_ru": "Сообщение", "examples": ["/tell Notch Hi"] }
      ]
    },
    {
      "name": "w",
      "category": "Basic",
      "opLevel": 0,
      "description": "Alias for /msg",
      "description_ru": "Псевдоним /msg",
      "example": "/w Notch Hi",
      "arguments": [
        { "value": "<target>", "description": "Recipient", "description_ru": "Получатель", "examples": ["/w Notch Hi"] },
        { "value": "<message>", "description": "Message", "description_ru": "Сообщение", "examples": ["/w Notch Hi"] }
      ]
    },
    {
      "name": "say",
      "category": "Basic",
      "opLevel": 2,
      "description": "Broadcast a message to all players",
      "description_ru": "Отправить сообщение всем игрокам",
      "example": "/say Hello everyone",
      "arguments": [
        { "value": "<message>", "description": "Message", "description_ru": "Сообщение", "examples": ["/say Hello everyone"] }
      ]
    },
    {
      "name": "seed",
      "category": "World",
      "opLevel": 0,
      "description": "Show world seed",
      "description_ru": "Показать сид мира",
      "example": "/seed",
      "arguments": [
        { "value": "[dimension]", "description": "Dimension seed", "description_ru": "Сид измерения", "examples": ["/seed minecraft:overworld", "/seed minecraft:the_nether"] }
      ]
    },
    {
      "name": "trigger",
      "category": "Basic",
      "opLevel": 0,
      "description": "Activate a scoreboard trigger",
      "description_ru": "Активировать триггер таблицы очков",
      "example": "/trigger myObjective",
      "arguments": [
        { "value": "<objective>", "description": "Trigger name", "description_ru": "Имя триггера", "examples": ["/trigger myObjective"] },
        { "value": "[value]", "description": "Value to set", "description_ru": "Значение для установки", "examples": ["/trigger myObjective set 1", "/trigger myObjective add 5"] }
      ]
    }
  ]
}