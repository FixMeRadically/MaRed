{
  "commands": [
    {
      "name": "worldborder",
      "category": "World",
      "opLevel": 2,
      "description": "Manage the world border",
      "example": "/worldborder set 1000",
      "arguments": [
        { "value": "add <distance>", "description": "Grow/shrink border", "examples": ["/worldborder add 100"] },
        { "value": "set <distance>", "description": "Set border size", "examples": ["/worldborder set 1000"] },
        { "value": "center <x> <z>", "description": "Set border center", "examples": ["/worldborder center 0 0"] },
        { "value": "damage amount <n>", "description": "Damage per block outside", "examples": ["/worldborder damage amount 5"] },
        { "value": "damage buffer <n>", "description": "Buffer distance", "examples": ["/worldborder damage buffer 10"] },
        { "value": "get", "description": "Show current border info", "examples": ["/worldborder get"] },
        { "value": "warning distance <n>", "description": "Warning distance", "examples": ["/worldborder warning distance 10"] },
        { "value": "warning time <n>", "description": "Warning time in seconds", "examples": ["/worldborder warning time 15"] }
      ]
    }
  ]
}