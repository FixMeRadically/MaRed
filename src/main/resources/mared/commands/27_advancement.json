{
  "commands": [
    {
      "name": "advancement",
      "category": "Player",
      "opLevel": 2,
      "description": "Grant or revoke advancements",
      "description_ru": "Выдать или забрать достижения",
      "example": "/advancement grant @s only minecraft:story/root",
      "arguments": [
        { "value": "grant", "description": "Give an advancement", "description_ru": "Выдать достижение", "examples": ["/advancement grant @s only minecraft:story/root"] },
        { "value": "revoke", "description": "Remove an advancement", "description_ru": "Забрать достижение", "examples": ["/advancement revoke @s only minecraft:story/root"] },
        { "value": "only <id>", "description": "Single advancement", "description_ru": "Одно достижение", "examples": ["/advancement grant @s only minecraft:story/smelt_iron"] },
        { "value": "everything", "description": "All advancements", "description_ru": "Все достижения", "examples": ["/advancement grant @s everything"] },
        { "value": "from <id>", "description": "From advancement tree", "description_ru": "Из дерева достижений", "examples": ["/advancement grant @s from minecraft:story/root"] },
        { "value": "through <id>", "description": "This and all children", "description_ru": "Это и все дочерние", "examples": ["/advancement grant @s through minecraft:story/root"] },
        { "value": "until <id>", "description": "All parents up to this", "description_ru": "Все родители до этого", "examples": ["/advancement grant @s until minecraft:story/root"] }
      ]
    }
  ]
}