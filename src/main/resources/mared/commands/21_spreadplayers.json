        { "value": "<maxRange>", "description": "Max distance from center", "description_ru": "Макс. расстояние от центра", "examples": ["/spreadplayers 0 0 10 20 false @a"] },
        { "value": "<respectTeams>", "description": "Keep teams together (true/false)", "description_ru": "Держать команды вместе (true/false)", "examples": ["/spreadplayers 0 0 10 20 true @a"] },
