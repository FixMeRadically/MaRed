package com.fixmer.mared.technology.server.setup;
import com.fixmer.genesis.technology.scripts.BuildSnapshot84;
import com.fixmer.genesis.technology.server.remote.*;
import com.google.gson.*;
import java.nio.file.*;import java.util.*;import java.util.concurrent.*;
/** One owner-local job. Automatic names/sets/preview/signing; explicit Launch authorizes the consent/commit chain. */
public final class AutoDeploymentService156 {
 private static final ExecutorService IO=Executors.newSingleThreadExecutor(r->{var t=new Thread(r,"MaRed-apply156");t.setDaemon(true);return t;});
 private static volatile boolean busy;private static volatile String state="IDLE",label="",job="",root="",error="",preparedSeal="",generation="",preparedSide="BOTH";
 private AutoDeploymentService156(){}
 public static boolean busy(){return busy;}public static String state(){return state;}public static String label(){return label;}public static String error(){return error;}public static String root(){return root;}
 public static boolean available(){try{return !InPlaceServerService104.folder().isBlank()&&Files.isRegularFile(Path.of(InPlaceServerService104.folder()).resolve("server.properties"));}catch(Exception invalid){return false;}}
 public static boolean canLaunch(){try{return !busy&&(state.equals("READY")||state.equals("ERROR")&&!label.isBlank()&&(error.equals("AUTO156_WAITING_FOR_CONSENT")||error.equals("AUTO156_CONNECT_TIMEOUT")||error.equals("AUTO156_DISTRIBUTION_SETUP_REQUIRED")||error.startsWith("HTTPS78_")))&&root.equals(ServerApp104.root(Path.of(InPlaceServerService104.folder())).toString());}catch(Exception invalid){return false;}}
 public static void refresh(){try{if(!root.equals(ServerApp104.root(Path.of(InPlaceServerService104.folder())).toString())||!InPlaceServerService104.matchesFolder128(InPlaceServerService104.folder()))return;}catch(Exception absent){return;}if(state.equals("COMMIT_QUEUED")&&InPlaceServerService104.state().getOrDefault("phase","").equals("RUNNING")&&!generation.equals(InPlaceServerService104.state().getOrDefault("generation",generation)))state="COMMITTED";}
 public static String side(BuildSnapshot84.Snapshot snapshot){try{String value=DedicatedPanelService75.preferences().getAsJsonObject("projectSides156").get(snapshot.projectId()).getAsString();return Set.of("CLIENT","SERVER","BOTH").contains(value)?value:"BOTH";}catch(Exception ignored){return "BOTH";}}
 public static synchronized void prepare(BuildSnapshot84.Snapshot snapshot){
  refresh();if(busy||snapshot==null||state.equals("COMMIT_QUEUED")||state.equals("OFFERING"))return;if(!available()){state="ERROR";error="SERVER156_SELECT_FOLDER";return;}if(state.equals("READY")&&preparedSeal.equals(snapshot.seal())&&preparedSide.equals(side(snapshot))&&canLaunch())return;preparedSeal=snapshot.seal();preparedSide=side(snapshot);String selectedSide=preparedSide;try{root=ServerApp104.root(Path.of(InPlaceServerService104.folder())).toString();}catch(Exception e){state="ERROR";error="SERVER156_SELECT_FOLDER";return;}
  busy=true;state="PREPARING";error="";label="";job=UUID.randomUUID().toString();String owner=root,id=job;
  var mc=net.minecraft.client.Minecraft.getInstance();String client=mc.gameDirectory.toPath().resolve("mods").toString();var prefs=ServerConnectionScreen156.forRoot(owner);String game=prefs.has("publication79game")?prefs.get("publication79game").getAsString():"",endpoint=prefs.has("publication79endpoint")?prefs.get("publication79endpoint").getAsString():"";
  IO.execute(()->{try{var checked=BuildSnapshot84.verify(snapshot.directory(),()->Thread.currentThread().isInterrupted());if(!checked.seal().equals(snapshot.seal()))throw new IllegalStateException("SCRIPT84_SNAPSHOT_CHANGED");
   String folder=Path.of(owner).getParent().getParent().toString();boolean running=false;try{running=ServerLocal105.observe(Path.of(folder)).getOrDefault("phase","").equals("RUNNING");}catch(Exception absent){}
   if(!running){state="STARTING_SERVER";var started=new CompletableFuture<Void>();mc.execute(()->{if(!folder.equals(Path.of(InPlaceServerService104.folder()).toAbsolutePath().normalize().toString())){started.completeExceptionally(new IllegalStateException("AUTO156_TARGET_CHANGED"));return;}InPlaceServerService104.action(folder,"start");started.complete(null);});started.get(5,TimeUnit.SECONDS);long deadline=System.nanoTime()+300_000_000_000L;
    while(System.nanoTime()<deadline){try{if(ServerLocal105.observe(Path.of(folder)).getOrDefault("phase","").equals("RUNNING")){running=true;break;}}catch(Exception notReady){}if(!InPlaceServerService104.working()&&!InPlaceServerService104.result().isBlank()&&!InPlaceServerService104.result().equals("DONE"))throw new IllegalStateException(InPlaceServerService104.result());Thread.sleep(500);}
    if(!running)throw new IllegalStateException("AUTO156_SERVER_START_TIMEOUT");state="PREPARING";
   }
   mc.execute(()->InPlaceServerService104.poll(folder));
   var response=call(List.of("auto-prepare156",owner,snapshot.directory().toString(),client,id,"--game",game,"--endpoint",endpoint,"--side",selectedSide));label=response.get("label").getAsString();generation=response.has("generation")?response.get("generation").getAsString():"";state="READY";
  }catch(Exception e){state="ERROR";error=code(e);}finally{busy=false;}});
 }
 public static synchronized void launch(){if(!canLaunch())return;busy=true;state="OFFERING";error="";String owner=root,id=job;
  var prefs=ServerConnectionScreen156.forRoot(owner);String cert=prefs.has("auto156cert")?prefs.get("auto156cert").getAsString():"",key=prefs.has("auto156key")?prefs.get("auto156key").getAsString():"",bind=prefs.has("auto156bind")?prefs.get("auto156bind").getAsString():"127.0.0.1";
  var mc=net.minecraft.client.Minecraft.getInstance();boolean join=mc.getConnection()==null;String folder=Path.of(owner).getParent().getParent().toString();
  IO.execute(()->{try{
   if(join){state="CONNECTING";var requested=new java.util.concurrent.atomic.AtomicBoolean();long deadline=System.nanoTime()+120_000_000_000L;boolean connected=false;
    while(System.nanoTime()<deadline){var ready=new CompletableFuture<Boolean>();mc.execute(()->{if(mc.getConnection()!=null&&mc.level!=null&&mc.player!=null){ready.complete(true);return;}InPlaceServerService104.poll(folder);if(!requested.get()&&InPlaceServerService104.canJoin128()){requested.set(true);InPlaceServerService104.join128(mc.screen);}ready.complete(false);});if(ready.get(5,TimeUnit.SECONDS)){connected=true;break;}Thread.sleep(500);}
    if(!connected)throw new IllegalStateException("AUTO156_CONNECT_TIMEOUT");Thread.sleep(1000);state="OFFERING";
   }
   var response=call(List.of("auto-launch156",owner,id,"--cert",cert,"--key",key,"--bind",bind));state=response.get("phase").getAsString();}catch(Exception e){state="ERROR";error=code(e);}finally{busy=false;}});
 }
 private static String code(Exception error){while((error instanceof ExecutionException||error instanceof CompletionException)&&error.getCause() instanceof Exception cause)error=cause;String code=error.getMessage();return code!=null&&code.matches("[A-Z][A-Z0-9_]{1,120}")?code:"AUTO156_OPERATION_FAILED";}
 private static JsonObject call(List<String> input)throws Exception{
  if(!System.getProperty("os.name","").toLowerCase(Locale.ROOT).startsWith("windows"))throw new IllegalStateException("AUTO156_WINDOWS_ONLY");
  Path bundle=DedicatedPanelService75.bundle(),out=Files.createTempFile(bundle,"automatic156-",".json"),err=Files.createTempFile(bundle,"automatic156-",".error");Process process=null;
  try{var args=new ArrayList<>(List.of("-3",bundle.resolve("tools/dedicated_server75.py").toString(),bundle.toString()));args.addAll(input);try{process=ServerHelperProcess116.start("pyw.exe",args,bundle,out,err);}catch(java.io.IOException noWindowless){process=ServerHelperProcess116.start("py.exe",args,bundle,out,err);}
   if(!ServerHelperProcess116.await(process,660,TimeUnit.SECONDS))throw new IllegalStateException("AUTO156_TIMEOUT");
   if(process.exitValue()!=0){String code=Files.size(err)<4096?Files.readString(err).trim():"";throw new IllegalStateException(code.matches("[A-Z][A-Z0-9_]{1,120}")?code:"AUTO156_OPERATION_FAILED");}
   if(Files.size(out)>65536)throw new IllegalStateException("AUTO156_RESULT_LIMIT");return JsonParser.parseString(Files.readString(out)).getAsJsonObject();
  }finally{if(process!=null&&process.isAlive()){process.destroy();if(!process.waitFor(3,TimeUnit.SECONDS))process.destroyForcibly();}Files.deleteIfExists(out);Files.deleteIfExists(err);}
 }
}
